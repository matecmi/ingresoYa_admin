rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAll(['admin'])
        && request.auth.token.admin == true;
    }

    // Perfiles y permisos del admin (docs/admin_staff_contract.md). Un token
    // admin sin `role` es de antes de los perfiles y vale como Dueño.
    function isStaffOwner() {
      return isAdmin() && request.auth.token.get('role', 'owner') == 'owner';
    }

    // `action`: v ver · e crear y editar · p publicar · a archivar o borrar.
    function can(section, action) {
      return isAdmin() && (isStaffOwner()
        || request.auth.token.get('p', {}).get(section, '').matches('.*' + action + '.*'));
    }

    // Alcance opcional por curso (`cs`); sin alcance, todos los cursos.
    function inCourseScope(courseId) {
      return isStaffOwner() || !request.auth.token.keys().hasAny(['cs'])
        || courseId in request.auth.token.cs;
    }

    function isStaffCollection(collectionName) {
      return collectionName in [
        'iya-admin-staff-test', 'iya-admin-staff-staging', 'iya-admin-staff'
      ];
    }

    function isStaffMetaCollection(collectionName) {
      return collectionName in [
        'iya-admin-roles-test', 'iya-admin-roles-staging', 'iya-admin-roles',
        'iya-admin-invites-test', 'iya-admin-invites-staging', 'iya-admin-invites'
      ];
    }

    function catalogSection(catalog) {
      return catalog.matches('iya-courses.*') ? 'courses'
        : catalog.matches('iya-config.*') ? 'settings'
        : 'universities';
    }

    // Una pregunta publicada o retirada solo la toca quien puede publicar;
    // retirarla exige además archivar.
    function questionWriteAllowed() {
      let next = request.resource.data.get('status', '');
      let prev = resource == null ? '' : resource.data.get('status', '');
      return can('questions', 'e')
        && inCourseScope(request.resource.data.get('courseId', ''))
        && ((next != 'published' && next != 'retired'
              && prev != 'published' && prev != 'retired')
            || can('questions', 'p'))
        && (next != 'retired' || prev == 'retired' || can('questions', 'a'));
    }

    function isCatalog(collectionName) {
      return collectionName in [
        'iya-universities-test', 'iya-universities-staging', 'iya-universities',
        'iya-professions-test', 'iya-professions-staging', 'iya-professions',
        'iya-config-test', 'iya-config-staging', 'iya-config',
        'iya-exams-dynamic-test', 'iya-exams-dynamic-staging', 'iya-exams-dynamic',
        'iya-courses-test', 'iya-courses-staging', 'iya-courses'
      ];
    }

    function isQuestionsCollection(collectionName) {
      return collectionName in [
        'iya-questions-test', 'iya-questions-staging', 'iya-questions'
      ];
    }

    function isAnswerKeyCollection(collectionName) {
      return collectionName in [
        'iya-question-answer-keys-test',
        'iya-question-answer-keys-staging',
        'iya-question-answer-keys'
      ];
    }

    function isQuestionMigrationRunCollection(collectionName) {
      return collectionName in [
        'iya-question-migration-runs-test',
        'iya-question-migration-runs-staging',
        'iya-question-migration-runs'
      ];
    }

    function isTemplateCollection(collectionName) {
      return collectionName in [
        'iya-exam-templates-test',
        'iya-exam-templates-staging',
        'iya-exam-templates'
      ];
    }

    function isAttemptCollection(collectionName) {
      return collectionName in [
        'iya-exam-attempts-test', 'iya-exam-attempts-staging', 'iya-exam-attempts'
      ];
    }

    function isLeaderboardCollection(collectionName) {
      return collectionName in [
        'iya-leaderboard-test', 'iya-leaderboard-staging', 'iya-leaderboard'
      ];
    }

    function isAliasCollection(collectionName) {
      return collectionName in [
        'iya-aliases-test', 'iya-aliases-staging', 'iya-aliases'
      ];
    }

    // Rankings (docs/rankings_contract.md): league seats and challenge
    // results are public to students; groups and challenges are server-only.
    function isPublicRankingCollection(collectionName) {
      return collectionName in [
        'iya-league-members-test', 'iya-league-members-staging', 'iya-league-members',
        'iya-challenge-entries-test', 'iya-challenge-entries-staging', 'iya-challenge-entries'
      ];
    }

    function isServerRankingCollection(collectionName) {
      return collectionName in [
        'iya-league-groups-test', 'iya-league-groups-staging', 'iya-league-groups',
        'iya-daily-challenges-test', 'iya-daily-challenges-staging', 'iya-daily-challenges'
      ];
    }

    function isProfileCollection(collectionName) {
      return collectionName in [
        'iya-profile-test', 'iya-profile-staging', 'iya-profile'
      ];
    }

    // Editor explanations contain answer rationale and are never readable by a
    // student. Legacy alternatives are handled separately below.
    match /{collectionName}/{questionId} {
      allow read: if can('questions', 'v') && collectionName in [
        'iya-questions-test-editor-private',
        'iya-questions-staging-editor-private',
        'iya-questions-editor-private'
      ];
      allow write: if can('questions', 'e') && collectionName in [
        'iya-questions-test-editor-private',
        'iya-questions-staging-editor-private',
        'iya-questions-editor-private'
      ];
    }

    // Conventional catalogs, including nested course/university catalogs.
    match /{catalog}/{document=**} {
      // Catalogs are needed by a signed-in learner to browse published
      // questions, but are not an anonymous data export surface.
      allow read: if signedIn() && isCatalog(catalog);
      allow write: if isCatalog(catalog)
        && can(catalogSection(catalog), 'e')
        && (catalogSection(catalog) != 'courses'
          || inCourseScope(request.path[4]));
    }

    // Question-bank roots are an editor/server surface. Learners receive only
    // their frozen, safe question snapshot from their own attempt; allowing
    // direct reads here would make the full bank enumerable.
    match /{collectionName}/{questionId} {
      allow read: if isQuestionsCollection(collectionName) && can('questions', 'v');
      allow create, update: if isQuestionsCollection(collectionName)
        && questionWriteAllowed()
        && !request.resource.data.keys().hasAny([
          'correctAlternativeId', 'isCorrect', 'explanation'
        ]);
      // Preserve the public history after it has ever become selectable.
      // Status-less documents are legacy drafts and retain the existing editor
      // deletion workflow until an explicit v2 migration is performed.
      allow delete: if isQuestionsCollection(collectionName) && can('questions', 'a')
        && (resource.data.status == 'draft'
          || !resource.data.keys().hasAny(['status']));
    }

    // Write-once question snapshot used by attempts. Functions use Admin SDK
    // and are not constrained by these client rules.
    match /{collectionName}/{questionId}/versions/{version} {
      allow read: if isQuestionsCollection(collectionName) && can('questions', 'v');
      allow create: if isQuestionsCollection(collectionName) && can('questions', 'p');
      allow update, delete: if false;
    }

    // Existing editor alternatives contain `isCorrect`, so they remain admin
    // only and cannot leak through the public root projection.
    match /{collectionName}/{questionId}/alternatives/{alternativeId} {
      allow read: if isQuestionsCollection(collectionName) && can('questions', 'v');
      allow write: if isQuestionsCollection(collectionName) && can('questions', 'e');
    }

    // Private key. It is editable only for the root's current draft revision.
    // Forking a root changes its version, which makes every old key immutable.
    match /{collectionName}/{keyId} {
      allow read: if isAnswerKeyCollection(collectionName) && can('questions', 'v');
      allow create, update: if isAnswerKeyCollection(collectionName) && can('questions', 'e')
        && request.resource.data.questionId is string
        && request.resource.data.version is int
        && (
          (collectionName == 'iya-question-answer-keys-test'
            && getAfter(/databases/$(database)/documents/iya-questions-test/$(request.resource.data.questionId)).data.status == 'draft'
            && getAfter(/databases/$(database)/documents/iya-questions-test/$(request.resource.data.questionId)).data.version == request.resource.data.version)
          || (collectionName == 'iya-question-answer-keys-staging'
            && getAfter(/databases/$(database)/documents/iya-questions-staging/$(request.resource.data.questionId)).data.status == 'draft'
            && getAfter(/databases/$(database)/documents/iya-questions-staging/$(request.resource.data.questionId)).data.version == request.resource.data.version)
          || (collectionName == 'iya-question-answer-keys'
            && getAfter(/databases/$(database)/documents/iya-questions/$(request.resource.data.questionId)).data.status == 'draft'
            && getAfter(/databases/$(database)/documents/iya-questions/$(request.resource.data.questionId)).data.version == request.resource.data.version)
        );
      // Clearing the correct answer is allowed only while the corresponding
      // draft is still current. Published and historical keys stay immutable.
      allow delete: if isAnswerKeyCollection(collectionName) && can('questions', 'e')
        && resource.data.questionId is string
        && resource.data.version is int
        && (
          (collectionName == 'iya-question-answer-keys-test'
            && get(/databases/$(database)/documents/iya-questions-test/$(resource.data.questionId)).data.status == 'draft'
            && get(/databases/$(database)/documents/iya-questions-test/$(resource.data.questionId)).data.version == resource.data.version)
          || (collectionName == 'iya-question-answer-keys-staging'
            && get(/databases/$(database)/documents/iya-questions-staging/$(resource.data.questionId)).data.status == 'draft'
            && get(/databases/$(database)/documents/iya-questions-staging/$(resource.data.questionId)).data.version == resource.data.version)
          || (collectionName == 'iya-question-answer-keys'
            && get(/databases/$(database)/documents/iya-questions/$(resource.data.questionId)).data.status == 'draft'
            && get(/databases/$(database)/documents/iya-questions/$(resource.data.questionId)).data.version == resource.data.version)
        );
    }

    // Dry-run reports contain editorial diagnostics and logical-backup
    // metadata. They are never visible to learners and can only be changed by
    // an authenticated admin running the migration process.
    match /{collectionName}/{runId}/{document=**} {
      allow read, write: if isQuestionMigrationRunCollection(collectionName)
        && isStaffOwner();
    }

    match /{collectionName}/{templateId} {
      // The server owns template selection and constraints. A learner cannot
      // enumerate templates or infer bank composition from the client.
      allow read: if isTemplateCollection(collectionName) && can('courses', 'v');
      allow write: if isTemplateCollection(collectionName) && can('courses', 'e');
    }

    match /{collectionName}/{templateId}/versions/{version} {
      allow read: if isTemplateCollection(collectionName) && can('courses', 'v');
      allow create: if isTemplateCollection(collectionName) && can('courses', 'e');
      allow update, delete: if false;
    }

    // Attempts are created, frozen and graded by Functions. The owner reads a
    // safe projection only; no client can write selection, result or answers.
    match /{collectionName}/{attemptId} {
      allow read: if isAttemptCollection(collectionName)
        && (can('students', 'v') || (signedIn() && resource.data.userId == request.auth.uid));
      allow write: if false;
    }

    // El UID del documento raíz es dueño de su perfil y de todo su árbol.
    match /{profiles}/{userId} {
      allow read, create, update, delete:
        if isProfileCollection(profiles) && isOwner(userId);
    }

    match /{profiles}/{userId}/{subcollection}/{document=**} {
      allow read, create, update, delete:
        if isProfileCollection(profiles) && isOwner(userId)
          && subcollection != 'examRequestKeys'
          && subcollection != 'recentQuestions'
          && subcollection != 'learningProgress'
          && subcollection != 'simulatorResults'
          && subcollection != 'pastExamBest'
          && subcollection != 'learningEvents'
          && subcollection != 'simulatorTopicStats'
          && subcollection != 'simulatorSummary'
          && subcollection != 'xp'
          && subcollection != 'xpEvents'
          && subcollection != 'ranking';
    }

    // Simulator results, best score per past exam and learning events are
    // written only by Functions; the owner reads them (history, statistics).
    match /{profiles}/{userId}/{subcollection}/{document} {
      allow read: if isProfileCollection(profiles) && isOwner(userId)
        && subcollection in ['simulatorResults', 'pastExamBest', 'learningEvents',
          'simulatorTopicStats', 'simulatorSummary', 'xp', 'xpEvents', 'ranking'];
    }

    // Admin XP tool (docs/xp_contract.md): find a student, read the XP
    // ledger and revert an event. Students never write their XP.
    match /{profiles}/{userId} {
      allow read: if isProfileCollection(profiles) && can('students', 'v');
    }

    match /{profiles}/{userId}/{subcollection}/{document} {
      allow read: if isProfileCollection(profiles) && can('students', 'v')
        && subcollection in ['xp', 'xpEvents', 'ranking', 'simulatorResults',
          'pastExamBest', 'simulatorTopicStats', 'learningEvents'];
      allow update: if isProfileCollection(profiles) && can('students', 'e')
        && subcollection in ['xp', 'xpEvents', 'ranking'];
    }

    // Public cards (docs/rankings_contract.md §4): readable by signed-in
    // students, written only by Functions. The admin keeps them in step when
    // reverting XP and removes one when moderating a username.
    match /{collectionName}/{userId} {
      allow read: if isLeaderboardCollection(collectionName) && signedIn();
      allow update, delete: if isLeaderboardCollection(collectionName) && can('students', 'e');
    }

    match /{collectionName}/{entryId} {
      allow read: if isPublicRankingCollection(collectionName) && signedIn();
      allow update, delete: if isPublicRankingCollection(collectionName) && can('students', 'e');
    }

    // The admin may look at groups and today's challenges and swap a
    // question of a challenge nobody has played yet.
    match /{collectionName}/{docId} {
      allow read: if isServerRankingCollection(collectionName) && can('students', 'v');
      allow update: if isServerRankingCollection(collectionName) && can('settings', 'e')
        && collectionName.matches('iya-daily-challenges.*');
    }

    // Alias reservations: server-only; the admin frees one when moderating.
    match /{collectionName}/{aliasKey} {
      allow read: if isAliasCollection(collectionName) && can('students', 'v');
      allow delete: if isAliasCollection(collectionName) && can('students', 'e');
    }

    // Fichas del personal del admin: cada uno lee la suya; con staff:v, todas.
    // Perfiles e invitaciones los lee cualquier miembro. Solo Functions escribe.
    match /{collectionName}/{uid} {
      allow read: if isStaffCollection(collectionName)
        && (isOwner(uid) || can('staff', 'v'));
      allow read: if isStaffMetaCollection(collectionName) && isAdmin();
      allow write: if false;
    }

    // Estadísticas por pregunta (docs/question_stats_contract.md): las
    // escribe el servidor; el admin solo marca «Está bien así» (`review`).
    match /{collectionName}/{statsId} {
      allow read: if collectionName in [
          'iya-question-stats-test', 'iya-question-stats-staging', 'iya-question-stats'
        ] && can('questions', 'v');
      allow update: if collectionName in [
          'iya-question-stats-test', 'iya-question-stats-staging', 'iya-question-stats'
        ] && can('questions', 'e')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review']);
    }

    // Noticias del alumno (docs/news_contract.md). El alumno lee solo las
    // publicadas (la app decide dónde mostrarlas según su universidad); el
    // admin con news:v ve también borradores y archivadas. Publicar, o tocar
    // una ya publicada, pide news:p; borrar pide news:a.
    function isNewsCollection(collectionName) {
      return collectionName in ['iya-news-test', 'iya-news-staging', 'iya-news'];
    }

    match /{collectionName}/{newsId} {
      allow read: if isNewsCollection(collectionName)
        && ((signedIn() && resource.data.get('status', '') == 'published')
          || can('news', 'v'));
      allow create, update: if isNewsCollection(collectionName)
        && can('news', 'e')
        && ((request.resource.data.get('status', '') != 'published'
              && (resource == null || resource.data.get('status', '') != 'published'))
            || can('news', 'p'))
        // Solo el servidor marca la notificación como enviada.
        && request.resource.data.get('pushSentAt', null)
          == (resource == null ? null : resource.data.get('pushSentAt', null));
      allow delete: if isNewsCollection(collectionName) && can('news', 'a');
    }

    // Historial de cambios del admin (docs/admin_audit_contract.md): lo
    // escriben solo los disparadores; se lee con history:v.
    match /{collectionName}/{entryId} {
      allow read: if collectionName in [
          'iya-admin-audit-test', 'iya-admin-audit-staging', 'iya-admin-audit'
        ] && can('history', 'v');
      allow write: if false;
    }

    // These records are server-owned: request IDs provide idempotency and
    // recent-question history affects unbiased selection.
    match /{profiles}/{userId}/examRequestKeys/{requestId} {
      allow read, write: if false;
    }

    match /{profiles}/{userId}/recentQuestions/{questionId} {
      allow read, write: if false;
    }

    // Learning unlocks are server-owned. The exam generator validates the
    // allowed part context against this progress and the course hierarchy.
    match /{profiles}/{userId}/learningProgress/{document=**} {
      allow read, write: if false;
    }

    // The owner may READ (never write) the server's part evidence so a new or
    // reinstalled device restores its verified parts. Awards and the summary
    // stay behind the callables.
    match /{profiles}/{userId}/learningProgress/current {
      allow get: if isProfileCollection(profiles)
        && (isOwner(userId) || can('students', 'v'));
    }
  }
}
