rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /question-editor/{fileName} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      // Immutable names preserve existing questions and undo history.
      allow update, delete: if false;
    }
  }
}
