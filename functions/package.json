{
  "name": "ingresoya-exam-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --max-warnings=0 src test",
    "test": "npm run build && node --test lib/test",
    "emulators": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "test:emulators": "npm run build && firebase emulators:exec --only auth,firestore,functions \"node --test lib/test\""
  },
  "dependencies": {
    "firebase-admin": "13.6.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.7",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  }
}
