# Required outside the Emulator Suite. Allowed values: test, staging, production.
INGRESOYA_ENV=test
# Same region as the Firestore database (nam5 lives in us-central1). A callable
# makes 5-12 Firestore round trips; in another region each one costs ~150 ms.
FUNCTIONS_REGION=us-central1
# Production enforces App Check by default. Set this explicitly in staging only
# after a real App Check provider is enabled; leave false for Emulator Suite.
FUNCTIONS_ENFORCE_APP_CHECK=false
# Warm instances (0-3) for create/submit/section callables. 0 in every
# environment: no idle cost. Raise only if cold starts hurt.
FUNCTIONS_MIN_INSTANCES=0
# Bounded selection knobs (docs/backend_costs.md). Lower = fewer reads per exam.
# Phase 3C moves them to {config}/exam so the admin can tune them per university.
EXAM_CANDIDATE_STARTS_PER_BLOCK=2
EXAM_MAX_CANDIDATES_PER_START=40
EXAM_RECENT_QUESTION_LIMIT=60
