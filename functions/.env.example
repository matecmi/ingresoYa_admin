# Required outside the Emulator Suite. Allowed values: test, staging, production.
INGRESOYA_ENV=test
FUNCTIONS_REGION=southamerica-east1
# Production enforces App Check by default. Set this explicitly in staging only
# after a real App Check provider is enabled; leave false for Emulator Suite.
FUNCTIONS_ENFORCE_APP_CHECK=false
# Bounded selection knobs. Defaults shown here are also enforced by config.ts.
EXAM_CANDIDATE_STARTS_PER_BLOCK=4
EXAM_MAX_CANDIDATES_PER_START=80
EXAM_RECENT_QUESTION_LIMIT=200
